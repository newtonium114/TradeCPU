// Throwaway synthesis-checkpoint ROM content for tradecpu_core_checkpoint.
// NOT part of the real design -- exercises every Stage 1+2 opcode so
// none of control_unit's decode branches look dead-code-eliminable to
// synthesis. Reuses tb_stage2_core.v's if/else program (scenario A,
// r1=10/r2=5) at addr0-14, followed by its backward-JMP loop program
// at addr15-27 (addresses and the loop's jump target shifted +15).
//
// addr0:  LOAD_IMM R1, 10
49000000
0000000A
// addr2:  LOAD_IMM R2, 5
4A000000
00000005
// addr4:  CMP_GT R3, R1, R2
2B280000
// addr5:  JMP_IF R3, 11 (THEN)
58600000
0000000B
// addr7:  LOAD_IMM R4, 222   (ELSE)
4C000000
000000DE
// addr9:  JMP 13 (END)
50000000
0000000D
// addr11: LOAD_IMM R4, 111   (THEN)
4C000000
0000006F
// addr13: LOAD_IMM R5, 999   (END)
4D000000
000003E7
// addr15: LOAD_IMM R1, 0
49000000
00000000
// addr17: LOAD_IMM R2, 4
4A000000
00000004
// addr19: LOAD_IMM R3, 1
4B000000
00000001
// addr21: LOOP: ADD R1, R1, R3
092C0000
// addr22: SUB R2, R2, R3
124C0000
// addr23: CMP_GT R4, R2, R0
2C400000
// addr24: JMP_IF R4, 21 (LOOP)
58800000
00000015
// addr26: LOAD_IMM R5, 999
4D000000
000003E7
